AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — auto-detected from whichever key is set below.
# Override explicitly: anthropic | gemini
# AGENT_LLM_PROVIDER=gemini

# Set exactly ONE provider key (this project is built against Gemini):
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

# Per-node model overrides (blank = provider default from spec/architecture.md):
# AGENT_LLM_MODEL_CODEGEN=gemini-3.1-pro     — code-generation node (generate_code)
# AGENT_LLM_MODEL_INTERPRET=gemini-2.5-flash — result-interpretation node (synthesize_answer)
AGENT_LLM_MODEL_CODEGEN=
AGENT_LLM_MODEL_INTERPRET=

# Iterative code-gen/execute/retry loop (spec/agent.md)
AGENT_MAX_RETRIES=3
AGENT_EXEC_TIMEOUT_SECONDS=15

# Optional: LangSmith tracing (spec/agent.md → Observability)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

PORT=8001
